{
  "name": "Enquiry",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "message": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "responded",
        "closed"
      ],
      "default": "new"
    },
    "response": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "message"
  ]
}