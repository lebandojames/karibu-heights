{
  "name": "Room",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "tagline": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "long_description": {
      "type": "string"
    },
    "size_sqm": {
      "type": "number"
    },
    "bed_type": {
      "type": "string"
    },
    "max_guests": {
      "type": "number"
    },
    "price_per_night": {
      "type": "number"
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "total_units": {
      "type": "number",
      "default": 4
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "maintenance",
        "hidden"
      ],
      "default": "active"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "policies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "price_per_night"
  ]
}