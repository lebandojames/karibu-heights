{
  "name": "Testimonial",
  "type": "object",
  "properties": {
    "guest_name": {
      "type": "string"
    },
    "country": {
      "type": "string"
    },
    "rating": {
      "type": "number",
      "default": 5
    },
    "review": {
      "type": "string"
    },
    "initials": {
      "type": "string"
    },
    "published": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "guest_name",
    "review"
  ]
}